// Ceci est votre fichier schema.prisma
// Chemin: backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODÈLES DE DONNÉES POUR SMARTHIRE AI
// ============================================

enum Role {
  CANDIDAT
  RECRUTEUR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REFUSED
  INTERVIEW
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CANDIDAT)
  status    String   @default("ACTIVE")  // ACTIVE, SUSPENDED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  candidateProfile CandidateProfile?
  companyProfile   CompanyProfile?
  messagesSent     Message[] @relation("sender")
  messagesReceived Message[] @relation("receiver")
  notifications    Notification[]

  @@map("users")
}

model CandidateProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo       String?
  description String?
  skills      String?  // Stocké comme JSON string
  experiences String?  // Stocké comme JSON string
  education   String?  // Stocké comme JSON string
  linkedin    String?
  github      String?
  portfolio   String?
  phone       String?  // ⭐ AJOUTÉ
  location    String?  // ⭐ AJOUTÉ
  cvUrl       String?
  cvScore     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  applications Application[]
  resumes      Resume[]

  @@map("candidate_profiles")
}

model CompanyProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ⭐ INFORMATIONS PERSONNELLES DU RECRUTEUR
  photo          String?
  firstName      String?
  lastName       String?
  phone          String?
  location       String?
  bio            String?
  linkedin       String?
  github         String?
  
  // ⭐ INFORMATIONS DE L'ENTREPRISE
  companyName    String
  logo           String?
  description    String?
  website        String?
  companyLocation String?
  industry       String?
  size           String?
  foundedYear    Int?
  contactEmail   String?
  contactPhone   String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  jobs Job[]

  @@map("company_profiles")
}

model Job {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  location    String?
  contract    String?   // CDI, CDD, Freelance, Stage
  salary      String?
  skills      String?   // Stocké comme JSON string
  experience  String?   // Junior, Confirmé, Senior
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  applications Application[]

  @@map("jobs")
}

model Resume {
  id          Int      @id @default(autoincrement())
  candidateId Int
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  analysis    String?  // Stocké comme JSON string
  score       Int?
  uploadedAt  DateTime @default(now())

  // Relations
  aiAnalysis AIAnalysis?

  @@map("resumes")
}

model AIAnalysis {
  id          Int      @id @default(autoincrement())
  resumeId    Int      @unique
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skills      String?  // Stocké comme JSON string
  experience  Int?
  education   String?  // Stocké comme JSON string
  suggestions String?  // Stocké comme JSON string
  createdAt   DateTime @default(now())

  @@map("ai_analyses")
}

model Application {
  id          Int      @id @default(autoincrement())
  jobId       Int
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId Int
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING)
  score       Int?
  coverLetter String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  interviews Interview[]

  @@map("applications")
}

model Interview {
  id          Int      @id @default(autoincrement())
  applicationId Int
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  duration    Int?     // en minutes
  location    String?  // URL pour visio ou adresse
  notes       String?
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("interviews")
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  sender      User     @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  Int
  receiver    User     @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("messages")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  type        String   // "APPLICATION", "MESSAGE", "INTERVIEW", "MATCH"
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())

  @@map("notifications")
}